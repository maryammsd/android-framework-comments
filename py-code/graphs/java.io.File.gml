    label "private void remove(ThreadGroup g)"
    type "method"
    comment "&#10;     * Removes the specified Thread group from this group.&#10;     * @param g the Thread group to be removed&#10;     * @return if this Thread has already been destroyed.&#10;     "
  ]
  node [
