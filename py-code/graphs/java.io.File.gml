    label " boolean isArchive()"
    type "method"
    comment "&#10;     * Returns the value of the archive attribute.&#10;     *&#10;     * <p> This attribute is typically used by backup programs.&#10;     *&#10;     * @return  the value of the archive attribute&#10;     "
  ]
  node [
