    label "public native char charAt(int index)"
    type "method"
    comment "&#10;    public char charAt(int index) {&#10;        if (isLatin1()) {&#10;            return StringLatin1.charAt(value, index);&#10;        } else {&#10;            return StringUTF16.charAt(value, index);&#10;        }&#10;    }&#10;    "
