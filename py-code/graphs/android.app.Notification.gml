    id 1509
    label "public String getHostAddress()"
    type "method"
    comment "&#10;     * Returns the IP address string in textual presentation.&#10;     *&#10;     * @return  the raw IP address in a string format.&#10;     * @since   JDK1.0.2&#10;     "
