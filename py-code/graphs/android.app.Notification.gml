    type "method"
    comment "&#10;     * Returns the value of the hidden attribute.&#10;     *&#10;     * <p> This attribute is often used to indicate if the file is visible to&#10;     * users.&#10;     *&#10;     * @return  the value of the hidden attribute&#10;     "
  ]
