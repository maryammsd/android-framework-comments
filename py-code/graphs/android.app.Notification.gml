    label "public void takePersistableUriPermission(@NonNull Uri uri, @Intent.AccessUriMode int modeFlags)"
    type "method"
    comment "&#10;     * Take a persistable URI permission grant that has been offered. Once&#10;     * taken, the permission grant will be remembered across device reboots.&#10;     * Only URI permissions granted with&#10;     * {@link Intent#FLAG_GRANT_PERSISTABLE_URI_PERMISSION} can be persisted. If&#10;     * the grant has already been persisted, taking it again will touch&#10;     * {@link UriPermission#getPersistedTime()}.&#10;     *&#10;     * @see #getPersistedUriPermissions()&#10;     "
  ]
