    type "method"
    comment "&#10;     * Gets the name of {@link android.service.quicksettings.TileService} is associated with&#10;     * this accessibility shortcut target.&#10;     *&#10;     * @return The class name of {@link android.service.quicksettings.TileService}.&#10;     "
