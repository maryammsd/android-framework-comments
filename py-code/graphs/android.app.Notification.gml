    type "method"
    comment "&#10;     * Set the beginning of the next contour to the point (x,y).&#10;     *&#10;     * @param x The x-coordinate of the start of a new contour&#10;     * @param y The y-coordinate of the start of a new contour&#10;     "
  ]
  node [
