    type "method"
    comment "&#10;     * Sets the drawable's color value. This action will clobber the results of&#10;     * prior calls to {@link #setAlpha(int)} on this object, which side-affected&#10;     * the underlying color.&#10;     *&#10;     * @param color The color to draw.&#10;     "
  ]
  node [
