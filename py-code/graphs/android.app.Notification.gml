    label "public final void setDataPosition(int pos)"
    type "method"
    comment "&#10;     * Move the current read/write position in the parcel.&#10;     * @param pos New offset in the parcel; must be between 0 and&#10;     * {@link #dataSize}.&#10;     "
  ]
  node [
    id 8580
    label "public final void setDataCapacity(int size)"
    type "method"
    comment "&#10;     * Change the capacity (current available space) of the parcel.&#10;     *&#10;     * @param size The new capacity of the parcel, in bytes.  Can not be&#10;     * less than {@link #dataSize} -- that is, you can not drop existing data&#10;     * with this method.&#10;     "
  ]
  node [
    id 8581
    label "public final byte[] marshall()"
    type "method"
    comment "&#10;     * Returns the raw bytes of the parcel.&#10;     *&#10;     * <p class=&#34;note&#34;>The data you retrieve here <strong>must not</strong>&#10;     * be placed in any kind of persistent storage (on local disk, across&#10;     * a network, etc).  For that, you should use standard serialization&#10;     * or another kind of general serialization mechanism.  The Parcel&#10;     * marshalled representation is highly optimized for local IPC, and as&#10;     * such does not attempt to maintain compatibility with data created&#10;     * in different versions of the platform.&#10;     "
  ]
  node [
    id 8582
    label "public final void unmarshall(@NonNull byte[] data, int offset, int length)"
    type "method"
    comment "&#10;     * Fills the raw bytes of this Parcel with the supplied data.&#10;     "
  ]
  node [
