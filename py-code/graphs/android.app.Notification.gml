    type "method"
    comment "&#10;     * Equivalent to invoking {@link #computeCurrentVelocity(int, float)} with a maximum&#10;     * velocity of Float.MAX_VALUE.&#10;     *&#10;     * @see #computeCurrentVelocity(int, float)&#10;     "
