    label "public PrecomputedText.Params getTextMetricsParams()"
    type "method"
    comment "&#10;     * Gets the parameters for text layout precomputation, for use with {@link PrecomputedText}.&#10;     *&#10;     * @return a current {@link PrecomputedText.Params}&#10;     * @see PrecomputedText&#10;     "
